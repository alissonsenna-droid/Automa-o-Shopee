# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Appmax (https://docs.appmax.com.br) — gere em Appmax → API → Credenciais → "Gerar credenciais"
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
APPMAX_ENVIRONMENT=sandbox
# Sem APPMAX_WEBHOOK_SECRET: a Appmax não envia assinatura/HMAC nos webhooks
# (confirmado em docs.appmax.com.br/guides/webhooks.md) — o webhook reconfere
# o status direto na API autenticada antes de confiar em qualquer payload.

# Só usadas pelo fluxo de instalação de App Store (src/lib/appmax/install.ts),
# que não é o caminho usado por este cliente transacional — deixe em branco.
APPMAX_API_KEY=
APPMAX_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notificações (desligadas por padrão — ver src/lib/notifications)
NOTIFICATIONS_ENABLED=false
