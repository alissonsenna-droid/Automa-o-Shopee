# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Appmax (https://docs.appmax.com.br) — gere em Appmax → API → Credenciais → "Gerar credenciais"
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
APPMAX_ENVIRONMENT=sandbox
# Sem APPMAX_WEBHOOK_SECRET: a Appmax não envia assinatura/HMAC nos webhooks
# (confirmado em docs.appmax.com.br/guides/webhooks.md) — o webhook reconfere
# o status direto na API autenticada antes de confiar em qualquer payload.

# Só usadas pelo fluxo de instalação de App Store (src/lib/appmax/install.ts),
# que não é o caminho usado por este cliente transacional — deixe em branco.
APPMAX_API_KEY=
APPMAX_SECRET=

# Appmax JS (tokenização de cartão no navegador — card nunca passa pelo
# nosso backend). Não são segredos: rodam no browser.
# URL por ambiente — produção: https://scripts.appmax.com.br/appmax.min.js
#                    sandbox:   https://scripts.sandboxappmax.com.br/appmax.min.js
NEXT_PUBLIC_APPMAX_SCRIPT_URL=
# "External ID" mostrado em Appmax → API → Credenciais, junto do Client ID/Secret.
NEXT_PUBLIC_APPMAX_EXTERNAL_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notificações (desligadas por padrão — ver src/lib/notifications)
NOTIFICATIONS_ENABLED=false

# Extensão de preenchimento de checkout (fazzo-order-automation). Gere uma
# chave aleatória longa (ex: openssl rand -hex 32) e configure a MESMA chave
# nas opções da extensão instalada no navegador. Trocar aqui revoga o acesso
# de qualquer extensão com a chave antiga.
FULFILLMENT_API_KEY=
